#!/bin/bash 
#SBATCH -J fit
#SBATCH -o /share/ju/matt/bayflood/.slurm_jobs/fit/%j.out
#SBATCH -e /share/ju/matt/bayflood/.slurm_jobs/fit/%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=mwf62@cornell.edu
#SBATCH -N 1
#SBATCH -n 8
#SBATCH --get-user-env 
#SBATCH --mem=400gb
#SBATCH -t 400:00:00 
#SBATCH --partition=pierson


pwd
source ~/.bashrc

cd /share/ju/matt/bayflood
source /share/ju/matt/bayflood/.venv/bin/activate
# --skip-data-generation: reuse the existing (fixed-adjacency) dataset/covariates
# so downsample runs are fit against the identical data as the full-data
# reference model (constants.CURRENT_DF). Downsampling is applied at fit time.
python pipeline.py --geometry-type $2 --prefix $1 --external-covariates --skip-data-generation --downsample-frac $3 --downsample-seed $4
